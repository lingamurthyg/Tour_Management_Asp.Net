@model Tour_Management.Models.LoginViewModel

@{
    ViewData["Title"] = "User Login";
}

<style type="text/css">
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-font-smoothing: antialiased;
    }

    .container-custom {
        text-align: center;
        background-color: black;
        width: 100%;
        font-size: 30px;
        color: white;
        padding-bottom: 150px;
        opacity: 0.8;
    }
</style>

<div class="login-form">
    <div class="container-custom">
        <div class="page-header">
            <h1>User Login</h1>
        </div>
        <form asp-action="Login" method="post">
            <div class="form-horizontal">
                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label>Email</label>
                    </div>
                    <div class="col-sm-6">
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                </div>
                <div class="form-group">
                    <div class="control-label col-sm-4">
                        <label>Password</label>
                    </div>
                    <div class="col-sm-6">
                        <input asp-for="Password" type="password" class="form-control" required />
                    </div>
                </div>
                <div class="form-group">
                    <div class="control-label col-sm-2">
                        <button type="submit" class="btn btn-warning" style="background-color:#cc6600; color:black;">Login</button>
                    </div>
                    <div class="control-label col-sm-2">
                        <a asp-action="SignUpForm" class="btn btn-warning" style="background-color:#cc6600; color:black;">Sign Up</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

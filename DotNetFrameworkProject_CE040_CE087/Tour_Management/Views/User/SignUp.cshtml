@model Tour_Management.Models.UserSignUpViewModel

@{
    ViewData["Title"] = "User Registration Form";
}

<style>
    .container-custom {
        text-align: center;
        background-color: black;
        width: 100%;
        font-size: 30px;
        color: white;
        padding-bottom: 150px;
        opacity: 0.8;
    }
</style>

<div class="container-custom">
    <div class="page-header">
        <h1>User Registration Form</h1>
    </div>
    <div class="form-horizontal">
        <form asp-action="Register" method="post">
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="Email">Email</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="FirstName">First Name</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="FirstName" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="LastName">Last Name</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="LastName" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="Gender">Gender</label>
                </div>
                <div class="col-sm-6">
                    <select asp-for="Gender" class="form-control">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="Password">Enter Password</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="Password" type="password" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label>Re-enter Password</label>
                </div>
                <div class="col-sm-6">
                    <input type="password" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="Dob">Date of birth(dd-mm-yyyy)</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="Dob" type="date" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="Street">Street</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="Street" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="City">City</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="City" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-4">
                    <label asp-for="State">State</label>
                </div>
                <div class="col-sm-6">
                    <input asp-for="State" class="form-control" required />
                </div>
            </div>
            <div class="form-group">
                <div class="control-label col-sm-2">
                    <button type="submit" class="btn btn-primary" style="background-color:#cc6600; color:black;">Register</button>
                </div>
                <div class="control-label col-sm-2">
                    <button type="reset" class="btn btn-secondary" style="background-color:#cc6600; color:black;">Reset</button>
                </div>
            </div>
        </form>
    </div>
</div>

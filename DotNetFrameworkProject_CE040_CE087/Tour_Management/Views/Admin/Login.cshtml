@model Tour_Management.Models.AdminLoginViewModel

@{
    ViewData["Title"] = "Admin Login";
}

<style>
    .container-custom {
        text-align: center;
        background-color: black;
        width: 100%;
        font-size: 30px;
        color: white;
        padding-bottom: 150px;
        opacity: 0.8;
    }
</style>

<div class="container-custom">
    <h1>Admin Login</h1>
    <form asp-action="Login" method="post">
        <label asp-for="Email">Email</label><br />
        <input asp-for="Email" class="form-control" /><br />
        <label asp-for="Password">Password</label><br />
        <input asp-for="Password" type="password" class="form-control" /><br />
        <button type="submit" class="btn btn-primary">login</button>
    </form>
</div>

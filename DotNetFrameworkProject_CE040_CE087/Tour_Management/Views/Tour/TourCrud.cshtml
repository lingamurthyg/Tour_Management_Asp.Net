@model IEnumerable<Tour_Management.Models.TourCrudViewModel>

@{
    ViewData["Title"] = "Manage Tours";
}

<div class="container">
    <h2>Manage Tours</h2>
    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>TOUR_ID</th>
                <th>TOUR_NAME</th>
                <th>PLACE</th>
                <th>DAYS</th>
                <th>PRICE</th>
                <th>LOCATIONS</th>
                <th>TOUR_INFO</th>
                <th>pic</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tour in Model)
            {
                <tr>
                    <td>@tour.TourId</td>
                    <td>@tour.TourName</td>
                    <td>@tour.Place</td>
                    <td>@tour.Days</td>
                    <td>@tour.Price</td>
                    <td>@tour.Locations</td>
                    <td>@tour.TourInfo</td>
                    <td>
                        <img src="~/Tour_pics/@tour.Pic" style="width:150px;height:150px" />
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@tour.TourId" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@tour.TourId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

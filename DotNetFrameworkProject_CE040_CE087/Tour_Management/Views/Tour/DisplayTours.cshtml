@model IEnumerable<Tour_Management.Models.TourDisplayViewModel>

@{
    ViewData["Title"] = "Display Tours";
}

<div class="container">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>TOUR_NAME</th>
                <th>DAYS</th>
                <th>LOCATIONS</th>
                <th>TOUR_ID</th>
                <th>pic</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TourName</td>
                    <td>@item.Days</td>
                    <td>@item.Locations</td>
                    <td>@item.TourId</td>
                    <td>
                        <img src="~/Tour_pics/@item.Pic" style="width:200px;height:200px" />
                    </td>
                    <td>
                        <a asp-controller="Booking" asp-action="Order" asp-route-id="@item.TourId" class="btn btn-primary">Book Now</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

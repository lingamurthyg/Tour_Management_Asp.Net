@model IEnumerable<Tour_Management.Models.TourDisplayViewModel>

@{
    ViewData["Title"] = "Display Tours";
}

<style type="text/css">
    .tour-grid {
        margin-right: 130px;
        margin-top: 21px;
        margin-left: 13px;
        width: 875px;
    }
    .tour-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        color: black;
        border: 1px solid #DEDFDE;
    }
    .tour-table th {
        background-color: #6B696B;
        color: white;
        font-weight: bold;
        padding: 4px;
        border: 1px solid #DEDFDE;
    }
    .tour-table td {
        background-color: #F7F7DE;
        text-align: center;
        padding: 4px;
        border: 1px solid #DEDFDE;
    }
    .tour-table tr:nth-child(even) td {
        background-color: white;
    }
</style>

<div class="tour-grid">
    <table class="tour-table">
        <thead>
            <tr>
                <th>TOUR_NAME</th>
                <th>DAYS</th>
                <th>LOCATIONS</th>
                <th>TOUR_ID</th>
                <th>pic</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TourName</td>
                    <td>@item.Days</td>
                    <td>@item.Locations</td>
                    <td>@item.TourId</td>
                    <td>
                        <img src="~/Tour_pics/@item.Pic" style="width:200px;height:200px" />
                    </td>
                    <td>
                        <a asp-controller="Booking" asp-action="Order" asp-route-id="@item.TourId">Book Now</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

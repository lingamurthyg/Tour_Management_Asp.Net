@model Tour_Management.Models.AddTourViewModel

@{
    ViewData["Title"] = "Add New Tour";
}

<style type="text/css">
    .page-header {
        text-align: center;
    }
    .form-horizontal {
        font-size: 30px;
        text-align: center;
    }
    .row .form-horizontal {
        border-right: 1px double;
    }
    .container-custom {
        text-align: center;
        background-color: black;
        width: 100%;
        font-size: 30px;
        color: white;
        padding-bottom: 150px;
        opacity: 0.8;
    }
</style>

<div class="page-header">
    <h1>Add New Tour</h1>
</div>

<div class="container-custom">
    <div class="row">
        <div class="form-horizontal col-md-7">
            <form asp-action="Register" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <label asp-for="TourName">Name of Tour</label>
                    </div>
                    <div class="col-sm-6">
                        <input asp-for="TourName" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <label asp-for="Place">Place</label>
                    </div>
                    <div class="col-sm-6">
                        <input asp-for="Place" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <label asp-for="Days">Days</label>
                    </div>
                    <div class="col-sm-6">
                        <input asp-for="Days" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <label asp-for="Locations">Locations</label>
                    </div>
                    <div class="col-sm-6">
                        <input asp-for="Locations" class="form-control" required />
                    </div>
                </div>

                <div class="col-md-5">
                    <p style="text-align:center; font-size:30px;">Image for Tour</p>
                    <input asp-for="TourImage" type="file" class="form-control" />
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <label asp-for="Price">Price</label>
                    </div>
                    <div class="col-sm-6">
                        <input asp-for="Price" class="form-control" required />
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <label asp-for="TourInfo">Tour Info</label>
                    </div>
                    <div class="col-sm-6">
                        <textarea asp-for="TourInfo" class="form-control" required></textarea>
                    </div>
                </div>

                <div class="form-group">
                    <div class="control-label col-sm-3">
                        <button type="submit" class="btn btn-primary" style="background-color:#cc6600; color:black;">Register</button>
                    </div>
                    <div class="control-label col-sm-3">
                        <button type="reset" class="btn btn-secondary" style="background-color:#cc6600; color:black;">Reset</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
